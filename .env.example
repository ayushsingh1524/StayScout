# Copy this file to .env and replace every value before starting Docker.
# Never commit .env; it is intentionally ignored by Git.
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-random-jwt-secret-at-least-32-characters-long

# Optional: creates an administrator only on the first application start.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional: enables Google Sign-In. This client ID is public; do not put a
# Google client secret in this file or in the frontend.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
